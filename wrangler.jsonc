{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atc-gold",
  "compatibility_date": "2026-05-08",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["RESEND_API_KEY"]
  }
}
