{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atc-gold",
  "compatibility_date": "2026-05-08",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["RESEND_API_KEY", "TURNSTILE_SECRET_KEY"]
  },
  // Configure TO_EMAIL, FROM_EMAIL, TURNSTILE_SITE_KEY, and optional
  // TURNSTILE_ALLOWED_HOSTNAMES as plain Worker variables in Cloudflare.
  // FROM_EMAIL must be a verified Resend sender. TURNSTILE_SECRET_KEY must be
  // stored as a secret, never exposed to the client.
  "vars": {
  "TO_EMAIL": "peter.lo@atcgoldllc.com",
  "FROM_EMAIL": "ATC GOLD CONSTRUCTION <atc_partner@balerionsolutions.ai>",
  "TURNSTILE_SITE_KEY": "turnstile_(08s&_keyATC",
  "TURNSTILE_ALLOWED_HOSTNAMES": "atcgoldllc.com, atc-gold.marco1996guevara.workers.dev"
}
}
